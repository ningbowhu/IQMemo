<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingHorizontal="24dp"
    android:paddingTop="16dp" android:paddingBottom="20dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelDelete"
        style="@style/AppButton.Secondary.Pill" android:layout_width="0dp"
        android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp"
        android:text="@string/cancel" android:textColor="@color/color_text_primary"
        android:insetTop="0dp" android:insetBottom="0dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmDelete"
        style="@style/AppButton.Record.Pill" android:layout_width="0dp"
        android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp"
        android:text="@string/delete" app:backgroundTint="@color/color_delete_button"
        android:insetTop="0dp" android:insetBottom="0dp" />
</LinearLayout>
